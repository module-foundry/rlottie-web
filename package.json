{
  "name": "@module-foundry/rlottie-web",
  "version": "0.1.0",
  "description": "Worker-first Samsung RLottie player for the web with React and SolidJS adapters",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26.6.0",
    "pnpm": ">=11.20.0"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./reactjs": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./solidjs": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "#react/*": {
      "types": "./dist/react/*.d.ts",
      "default": "./dist/react/*.js"
    },
    "#solid/*": {
      "types": "./dist/solid/*.d.ts",
      "default": "./dist/solid/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "benchmark": "vitest bench --run benchmarks/timeline.bench.ts",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-playgrounds.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "pack:verify": "node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:memory": "vitest run tests/memory",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "verify": "corepack pnpm@11.20.0 format:check && corepack pnpm@11.20.0 lint && corepack pnpm@11.20.0 typecheck && corepack pnpm@11.20.0 test && corepack pnpm@11.20.0 wasm:verify && corepack pnpm@11.20.0 build && corepack pnpm@11.20.0 pack:verify && corepack pnpm@11.20.0 test:browser",
    "wasm:build": "node packages/wasm/scripts/build.mjs",
    "wasm:verify": "node packages/wasm/scripts/verify.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20",
    "solid-js": ">=1.9.0 <2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@module-foundry/configs": "0.0.1",
    "@playwright/test": "1.62.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
